{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions plus the plugins the app actually calls from JS.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "process:default",
    "updater:default",
    "shell:allow-open",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
