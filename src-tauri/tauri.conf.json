{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sahara Dashboard",
  "version": "0.9.5",
  "identifier": "com.sahara.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sahara Dashboard",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://192.168.1.128:8080 http://127.0.0.1:8080 http://localhost:8080 https://api.spotify.com https://accounts.spotify.com https://lrclib.net; img-src 'self' https: data:; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NzE0NUEwNzgwNkNBNzEKUldSeHlnWjRvRVZ4TjBSai80V1VJaWtBWkd0T0xzTXAza2YyTEk0NDJqdnp5M3cvTk1NOVcrWFkK",
      "endpoints": [
        "https://github.com/Andrehoey505/sahara-dashboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}